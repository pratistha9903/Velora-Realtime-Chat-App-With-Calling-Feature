PORT=3001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/pulsechat
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
AUTO_VERIFY_EMAIL=true
GOOGLE_CLIENT_ID=

APP_NAME=Velora

# Optional n8n webhook — POST on each message: senderName, senderEmail, recipientName, recipientEmail, message
# Test URL: use while n8n workflow is in "Listen for test event" mode
N8N_WEBHOOK_URL=https://pratistha09.app.n8n.cloud/webhook-test/29e2ff8e-b23a-4d11-9d73-f3c545c8ff5b

# Email (required for forgot-password emails)
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Velora <your-gmail@gmail.com>


